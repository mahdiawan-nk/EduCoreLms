# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime & Admin Credentials (injected automatically by AI Studio Cloud SQL integration)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Session & CSRF Security
SESSION_SECRET="politeknik-kampar-lms-production-secret-key"

# S3-Compatible Object Storage Configuration
S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
S3_BUCKET="poltek-kampar-lms-private"
S3_REGION="ap-southeast-1"

# ==========================================
# APPLICATION & ENVIRONMENT
# ==========================================
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# ==========================================
# POSTGRESQL RUNTIME
# ==========================================
SQL_HOST="127.0.0.1"
SQL_PORT=5432
SQL_DB_NAME="polkam_database"
SQL_USER="postgres"
SQL_PASSWORD="your-strong-password"

# ==========================================
# POSTGRESQL ADMIN / MIGRATION
# ==========================================
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your-strong-password"

# ==========================================
# SESSION & CSRF SECURITY
# ==========================================
# Generate a cryptographically strong 64-character random string in production
SESSION_SECRET="politeknik-kampar-lms-development-secret-key-change-in-production"

# ==========================================
# S3-COMPATIBLE OBJECT STORAGE CONFIGURATION
# ==========================================
S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
S3_BUCKET="poltek-kampar-lms-private"
S3_REGION="ap-southeast-1"
